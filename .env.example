# Copie este arquivo para .env e preencha os valores reais.
# O .env NUNCA vai para o git.
#
# Na Vercel estas mesmas variáveis são cadastradas em
# Project Settings -> Environment Variables.

# Porta da API (só usada rodando local ou em servidor tradicional).
# Na Vercel a porta é gerenciada pela plataforma.
PORTA=4000

# String de conexão do MongoDB Atlas
MONGODB_URI=mongodb+srv://usuario:senha@cluster0.xxxxx.mongodb.net/sistema-delivery?retryWrites=true&w=majority

# Segredo para assinar os tokens (gere um aleatório longo)
JWT_SEGREDO=troque-por-uma-string-aleatoria-longa

# Validade do token
JWT_EXPIRA_EM=7d

# URL do front (CORS). Precisa ser o endereço EXATO, sem barra no fim.
# Local:    http://localhost:5173
# Produção: https://icardapio.vercel.app
URL_FRONT=http://localhost:5173

# Cloudinary - upload de imagem (foto do produto, logo e capa da loja).
# A secret fica SO no servidor: o navegador recebe apenas a assinatura.
# Painel: https://console.cloudinary.com -> Dashboard (Cloud name / API Key / API Secret).
CLOUDINARY_CLOUD_NAME=seu-cloud-name
CLOUDINARY_API_KEY=sua-api-key
CLOUDINARY_API_SECRET=sua-api-secret
