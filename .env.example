# Copie este arquivo para .env e preencha os valores reais.
# O .env NUNCA vai para o git.

# Porta da API
PORTA=4000

# String de conexão do MongoDB Atlas
MONGODB_URI=mongodb+srv://usuario:senha@cluster0.xxxxx.mongodb.net/sistema-delivery?retryWrites=true&w=majority

# Segredo para assinar os tokens (gere um aleatório longo)
JWT_SEGREDO=troque-por-uma-string-aleatoria-longa

# Validade do token
JWT_EXPIRA_EM=7d

# URL do front (CORS)
URL_FRONT=http://localhost:5173
